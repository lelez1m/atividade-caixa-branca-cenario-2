digraph Registrar {
 graph [label="Grafo do ORIGINAL — registrarSaida(String,int)",labelloc=t,fontsize=19,rankdir=TB];
 node [shape=box,style="rounded,filled",fillcolor="#eef4ff",fontname="Arial"];
 1 [label="1 Início",shape=oval]; 2 [label="2 disponível = consultarQuantidade(codigo)"];
 3 [label="3 quantidade <= disponivel?",shape=diamond,fillcolor="#fff2d9"];
 4 [label="4 new FileWriter(..., true)"];
 5 [label="5 escrita.write(...)"];
 6 [label="6 ultimaMovimentacao = codigo"];
 7 [label="7 return true"];
 8 [label="8 catch IOException\n(falha ignorada)",fillcolor="#ffe8e8"];
 9 [label="9 return false"];
 10 [label="10 Fim (saída unificada)",shape=oval];
 11 [label="11 Exceção não capturada\n(propagada da consulta)",fillcolor="#ffe8e8"];
 1->2; 2->3 [label="sucesso"]; 2->11 [label="exceção unchecked"];
 3->4 [label="sim"]; 3->9 [label="não"];
 4->5 [label="sucesso"]; 4->8 [label="IOException"];
 5->6 [label="sucesso"]; 5->8 [label="IOException"];
 6->7; 7->10; 8->9; 9->10; 11->10 [style=dashed,label="terminação excepcional"];
}
